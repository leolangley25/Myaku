# Myaku configuration. Copy to .env and fill in what you need; every value is optional.
# The server reads .env automatically on start.

# ---- Server ----
PORT=3000
# Set when running behind HTTPS through a proxy or tunnel (ngrok, Cloudflare Tunnel),
# so secure cookies and redirect URLs use the public https address.
# TRUST_PROXY=1
# The public address the phone reaches, used to build OAuth redirect URLs.
# PUBLIC_ORIGIN=https://myaku.example.com
# Extra origins allowed to make API requests, comma separated.
# ALLOWED_ORIGINS=

# ---- Secrets ----
# Generated into data/ on first run when unset. Set these in production so they
# live in your secret manager rather than on disk.
# SESSION_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- Assistant ----
# Answers questions about an athlete's own readings. Each athlete also has to turn
# it on for their own account, and with no model set up at all the Ask page says so
# rather than sending anything anywhere.
#
# A model on this machine is preferred over a hosted one whenever it is running,
# because then the readings never leave the device. Ollama is the default:
#   ollama serve            (usually already running after install)
#   ollama pull gemma3:4b   (any chat model works)
# MYAKU_LOCAL_URL=http://127.0.0.1:11434
# Pick a specific model; otherwise the first one Ollama lists is used.
# MYAKU_LOCAL_MODEL=gemma3:4b
# Small models on a laptop can take half a minute to answer.
# MYAKU_LOCAL_TIMEOUT_MS=90000
#
# Used only when no local model is running.
# ANTHROPIC_API_KEY=

# ---- Whoop (developer.whoop.com) ----
# Redirect URI to register: <PUBLIC_ORIGIN>/api/integrations/whoop/callback
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=

# ---- Google Health API: Fitbit Air, Fitbit, Pixel Watch (developers.google.com/health) ----
# Redirect URI to register: <PUBLIC_ORIGIN>/api/integrations/google/callback
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# GOOGLE_HEALTH_REDIRECT_URI=
